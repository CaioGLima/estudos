--Criando tabelas Cliente e Pedidos
CREATE TABLE Clientes(
	id_cliente int primary key IDENTITY(1, 1),
  	Name varchar (20)
);

Create TABLE Pedidos(
	id_pedido int IDENTITY(1,1),
  	id_cliente int,
  	Produto varchar (50),
  	Valor int ,
  	FOREIGN KEY(id_cliente) REFERENCES Clientes(id_cliente)
);

